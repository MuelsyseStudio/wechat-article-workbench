{
  "name": "wechat-article-workbench",
  "version": "2.4.0",
  "description": "零依赖微信公众号文章采集、按名称搜号换算、多号定时订阅、群聊机器人日报推送与深度 Markdown 清洗工作台（Web UI + wxclean CLI + 本地 MCP）",
  "license": "MIT",
  "type": "module",
  "private": false,
  "homepage": "https://github.com/zianxu78-ux/wechat-article-workbench",
  "repository": {
    "type": "git",
    "url": "https://github.com/zianxu78-ux/wechat-article-workbench.git"
  },
  "keywords": [
    "wechat",
    "weread",
    "markdown",
    "cli",
    "mcp",
    "knowledge-base",
    "obsidian"
  ],
  "bin": {
    "wxclean": "./cli.mjs",
    "wxclean-mcp": "./mcp-server.mjs"
  },
  "scripts": {
    "start": "node ./web-server.mjs --port 4546 --open",
    "web": "node ./web-server.mjs --port 4546 --open",
    "cli": "node ./cli.mjs",
    "doctor": "node ./cli.mjs doctor",
    "mcp": "node ./mcp-server.mjs",
    "mcp:http": "node ./mcp-server.mjs --http --port 4546"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
